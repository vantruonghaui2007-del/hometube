<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Đang tải -->
    <TextView
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_overlay_card"
        android:paddingBottom="18dp"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:paddingTop="18dp"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Thẻ "Tiếp theo" -->
    <LinearLayout
        android:id="@+id/upNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_margin="28dp"
        android:background="@drawable/bg_overlay_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIẾP THEO"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/upNextTitle"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/upNextBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Tone lớn khi vừa đổi -->
    <TextView
        android:id="@+id/toneBig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_margin="28dp"
        android:paddingBottom="12dp"
        android:paddingLeft="26dp"
        android:paddingRight="26dp"
        android:paddingTop="12dp"
        android:textSize="40sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Tạm dừng / xác nhận bỏ qua -->
    <TextView
        android:id="@+id/centerNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_overlay_card"
        android:gravity="center"
        android:paddingBottom="20dp"
        android:paddingLeft="34dp"
        android:paddingRight="34dp"
        android:paddingTop="20dp"
        android:textColor="@color/text"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Lỗi video -->
    <TextView
        android:id="@+id/errorBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@color/error_bg"
        android:paddingBottom="12dp"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="12dp"
        android:textColor="#FFFFE2E2"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Nhắc cách gọi thanh điều khiển -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_overlay_card"
        android:paddingBottom="10dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:text="Bấm OK (hoặc chạm vào màn hình) để hiện nút điều khiển  ·  ▲▼ đổi tone"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Thanh điều khiển -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hud"
        android:orientation="vertical"
        android:paddingBottom="18dp"
        android:paddingLeft="36dp"
        android:paddingRight="36dp"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/by"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/toneChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:paddingBottom="6dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vocalChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:paddingBottom="6dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pos"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:textColor="#FFD5DAE1"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:focusable="false"
                android:max="1000"
                android:progressDrawable="@drawable/progress_hud" />

            <TextView
                android:id="@+id/dur"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:textColor="#FFD5DAE1"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/btnToneDown" style="@style/TvButton" android:layout_width="56dp" android:layout_height="52dp" android:text="−" android:textSize="26sp" />

            <LinearLayout
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TONE" android:textColor="@color/muted" android:textSize="12sp" />
                <TextView android:id="@+id/toneValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/btnToneUp" style="@style/TvButton" android:layout_width="56dp" android:layout_height="52dp" android:text="+" android:textSize="26sp" />
            <TextView android:id="@+id/btnToneReset" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginLeft="8dp" android:text="Về gốc" android:textSize="15sp" />
            <TextView android:id="@+id/btnPause" style="@style/TvButton.Primary" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginLeft="16dp" android:text="❚❚ Tạm dừng" android:textSize="17sp" />
            <TextView android:id="@+id/btnNext" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginLeft="10dp" android:text="Bài kế ►" android:textSize="17sp" />
            <TextView android:id="@+id/btnVocal" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginLeft="10dp" android:text="Tắt lời ca sĩ" android:textSize="17sp" />
            <TextView android:id="@+id/btnMore" style="@style/TvButton" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginLeft="10dp" android:text="Chọn thêm bài" android:textSize="17sp" />

            <TextView
                android:id="@+id/left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:textColor="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="▲/▼ khi thanh ẩn: đổi tone   ·   OK / chạm màn hình: hiện thanh này   ·   0 Về tone gốc   ·   5 Tắt lời   ·   Menu Hàng chờ   ·   Back: ẩn thanh / về trang chính (nhạc vẫn chạy)"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Màn hình chờ khi hết bài -->
    <LinearLayout
        android:id="@+id/idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_launcher" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Hàng chờ trống" android:textColor="@color/text" android:textSize="40sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Chọn bài bằng remote, hoặc quét mã QR bằng điện thoại để mọi người cùng chọn bài." android:textColor="@color/muted" android:textSize="20sp" />
            <TextView android:id="@+id/btnIdleHome" style="@style/TvButton.Primary" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Chọn bài" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="64dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/idleQr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_qr"
                android:contentDescription="Mã QR chọn bài bằng điện thoại"
                android:padding="8dp" />

            <TextView
                android:id="@+id/idleUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
