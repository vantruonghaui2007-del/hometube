<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HomeKara" parent="android:Theme.Holo.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
    </style>

    <style name="Text" parent="android:TextAppearance">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Text.Muted"><item name="android:textColor">@color/muted</item><item name="android:textSize">15sp</item></style>
    <style name="Text.Title"><item name="android:textSize">22sp</item><item name="android:textStyle">bold</item></style>

    <!-- Nút điều khiển bằng remote: viền vàng khi được chọn -->
    <style name="TvButton">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TvButton.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>
    <style name="Chip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
